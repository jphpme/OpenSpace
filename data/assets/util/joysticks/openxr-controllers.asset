-- Navigation with the hand controllers of an OpenXR headset. The OpenSpace application
-- exposes both controllers as one virtual joystick, laid out like a gamepad
local OpenXRControllers = {
  LeftThumbStick = {
    LeftRight = 0,
    UpDown = 1
  },
  RightThumbStick = {
    LeftRight = 2,
    UpDown = 3
  },
  LeftTrigger = 4,
  RightTrigger = 5,
  LeftGrip = 6,
  RightGrip = 7,
  A = 0,
  B = 1,
  X = 2,
  Y = 3,
  LeftStickButton = 4,
  RightStickButton = 5,
  Menu = 6,
  LeftGripButton = 7,
  RightGripButton = 8
}

local Name = "OpenXR Controllers"

-- Joystick sensitivity while a grip is held, and when it is released. The normal value
-- matches the one set in the vr profile
local PrecisionSensitivity = 1.0
local NormalSensitivity = 5.0

-- The thumbstick axes of the two navigation modes, as { axis, axis type, inverted }.
-- Locked: the left thumbstick orbits around the focus, the right one zooms (up and
-- down) and turns the view in place (left and right).
-- Free flight: the left thumbstick turns left and right and flies up and down, the right
-- one flies forward and back (up and down) and sideways (left and right). Forward is
-- along the right controller's pointing ray (see the FlyAlongVRController property)
local LockedAxes = {
  { OpenXRControllers.LeftThumbStick.LeftRight, "Orbit X", false },
  { OpenXRControllers.LeftThumbStick.UpDown, "Orbit Y", true },
  { OpenXRControllers.RightThumbStick.UpDown, "Zoom", true },
  { OpenXRControllers.RightThumbStick.LeftRight, "Pan X", true }
}
local FreeFlightAxes = {
  { OpenXRControllers.LeftThumbStick.LeftRight, "Pan X", true },
  { OpenXRControllers.LeftThumbStick.UpDown, "Fly Up", true },
  { OpenXRControllers.RightThumbStick.UpDown, "Fly Forward", true },
  { OpenXRControllers.RightThumbStick.LeftRight, "Fly Right", false }
}

local function bindAxesCommand(axes)
  local command = ""
  for _, axis in ipairs(axes) do
    command = command .. string.format(
      "openspace.navigation.bindJoystickAxis(%q, %d, %q, %s)\n",
      Name, axis[1], axis[2], tostring(axis[3])
    )
  end
  return command
end

-- The bodies that locking can focus on (the one with the closest surface is picked) and
-- that the fly-to buttons step through, in this order. Bodies that are not in the scene
-- are skipped
local Bodies = {
  "Sun", "Mercury", "Venus", "Earth", "Moon", "Mars", "Jupiter", "Saturn", "Uranus",
  "Neptune"
}
local BodiesLua = '{ "' .. table.concat(Bodies, '", "') .. '" }'

local FocusClosestCommand = [[
  local candidates = ]] .. BodiesLua .. [[
  local state = openspace.navigation.getNavigationState("Root")
  local anchor = openspace.worldPosition(state.Anchor)
  local camera = {
    anchor[1] + state.Position[1],
    anchor[2] + state.Position[2],
    anchor[3] + state.Position[3]
  }
  local closest = nil
  local closestDistance = math.huge
  for _, id in ipairs(candidates) do
    if openspace.hasSceneGraphNode(id) then
      local p = openspace.worldPosition(id)
      local distance = math.sqrt(
        (p[1] - camera[1])^2 + (p[2] - camera[2])^2 + (p[3] - camera[3])^2
      ) - openspace.interactionSphere(id)
      if distance < closestDistance then
        closest = id
        closestDistance = distance
      end
    end
  end
  if closest then
    openspace.navigation.setFocus(closest)
  end
]]

local LockedMode = {
  Identifier = "os.vr.LockedNavigation",
  Name = "Locked VR navigation",
  Command = bindAxesCommand(LockedAxes) ..
    'openspace.setPropertyValueSingle("Modules.VR.FreeFlight", false)\n',
  Documentation = [[
    Bind the OpenXR controller thumbsticks to orbit around and zoom towards the focus]],
  GuiPath = "/Navigation/VR",
  IsLocal = true
}

local FreeFlightMode = {
  Identifier = "os.vr.FreeFlightNavigation",
  Name = "Free flight VR navigation",
  Command = bindAxesCommand(FreeFlightAxes) ..
    'openspace.setPropertyValueSingle("Modules.VR.FreeFlight", true)\n',
  Documentation = [[
    Bind the OpenXR controller thumbsticks to look around and to fly forward, back and
    sideways independently of the focus]],
  GuiPath = "/Navigation/VR",
  IsLocal = true
}

-- A short-lived message floating in front of the user: 1.5 m ahead and slightly below
-- eye level, in the tracking space of the headset
local Message = {
  Type = "ScreenSpaceText",
  Identifier = "VRMessage",
  Name = "VR message",
  Enabled = false,
  Text = "",
  FontSize = 48,
  Placement = {
    CartesianPosition = { 0.0, -0.2, -1.5 },
    FaceCamera = true,
    Scale = 0.3
  },
  Style = {
    BackgroundColor = { 0.0, 0.0, 0.0, 0.5 }
  }
}

-- Returns Lua code that shows the result of the Lua expression `text` as the message,
-- which then fades out
local function showMessageCommand(text)
  local uri = "ScreenSpace." .. Message.Identifier
  return string.format(
    "openspace.setPropertyValueSingle(%q, %s)\n" ..
    "openspace.fadeIn(%q, 0.2, 'openspace.fadeOut(\"%s\", 2.5)')\n",
    uri .. ".Text", text, uri, uri
  )
end

local ToggleNavigationMode = {
  Identifier = "os.vr.ToggleNavigationMode",
  Name = "Toggle locked and free flight VR navigation",
  Command = string.format([[
    if not openspace.propertyValue("Modules.VR.FreeFlight") then
      openspace.action.triggerAction(%q)
      %s
    else
      %s
      openspace.action.triggerAction(%q)
      %s
    end
  ]],
    FreeFlightMode.Identifier,
    showMessageCommand('"Free flight"'),
    FocusClosestCommand, LockedMode.Identifier,
    showMessageCommand(
      '"Locked on " .. openspace.propertyValue("NavigationHandler.OrbitalNavigator.Anchor")'
    )
  ),
  Documentation = [[
    Switches between free flight and locked navigation. Locking focuses on the body with
    the closest surface]],
  GuiPath = "/Navigation/VR",
  IsLocal = true
}

-- Returns Lua code that flies to the body `step` places after (or before, if negative)
-- the current focus in `Bodies`, and switches to locked navigation
local function flyToBodyCommand(step)
  return string.format([[
    local bodies = %s
    local anchor = openspace.propertyValue("NavigationHandler.OrbitalNavigator.Anchor")
    local index = 0
    for i, id in ipairs(bodies) do
      if id == anchor then
        index = i
      end
    end
    local target = nil
    for _ = 1, #bodies do
      index = (index - 1 + %d) %% #bodies + 1
      if openspace.hasSceneGraphNode(bodies[index]) then
        target = bodies[index]
        break
      end
    end
    if target then
      openspace.navigation.flyTo(target)
      openspace.action.triggerAction(%q)
      %s
    end
  ]],
    BodiesLua, step, LockedMode.Identifier, showMessageCommand('"Flying to " .. target')
  )
end

local FlyToNextBody = {
  Identifier = "os.vr.FlyToNextBody",
  Name = "Fly to the next body",
  Command = flyToBodyCommand(1),
  Documentation = [[
    Flies to the next of the Sun, the planets and the Moon, ordered by distance from
    the Sun, and locks onto it]],
  GuiPath = "/Navigation/VR",
  IsLocal = true
}

local FlyToPreviousBody = {
  Identifier = "os.vr.FlyToPreviousBody",
  Name = "Fly to the previous body",
  Command = flyToBodyCommand(-1),
  Documentation = [[
    Flies to the previous of the Sun, the planets and the Moon, ordered by distance from
    the Sun, and locks onto it]],
  GuiPath = "/Navigation/VR",
  IsLocal = true
}

local function bindInputs()
  local controller = OpenXRControllers
  local deadzone = 0.15

  openspace.navigation.setAxisDeadZone(Name, controller.LeftThumbStick.LeftRight, deadzone)
  openspace.navigation.setAxisDeadZone(Name, controller.LeftThumbStick.UpDown, deadzone)
  openspace.navigation.setAxisDeadZone(Name, controller.RightThumbStick.LeftRight, deadzone)
  openspace.navigation.setAxisDeadZone(Name, controller.RightThumbStick.UpDown, deadzone)

  openspace.action.triggerAction(LockedMode.Identifier)
  openspace.navigation.bindJoystickButton(
    Name,
    controller.RightStickButton,
    "openspace.action.triggerAction('" .. ToggleNavigationMode.Identifier .. "')",
    "Switch between locked navigation and free flight"
  )

  -- Holding a grip makes all movement slower for fine adjustments
  local sensitivityUri = "NavigationHandler.OrbitalNavigator.Input.JoystickSensitivity"
  for _, grip in ipairs({ controller.LeftGripButton, controller.RightGripButton }) do
    openspace.navigation.bindJoystickButton(
      Name,
      grip,
      "openspace.setPropertyValueSingle('" .. sensitivityUri .. "', " ..
        PrecisionSensitivity .. ")",
      "Slow down movement while the grip is held",
      "Press"
    )
    openspace.navigation.bindJoystickButton(
      Name,
      grip,
      "openspace.setPropertyValueSingle('" .. sensitivityUri .. "', " ..
        NormalSensitivity .. ")",
      "Restore the movement speed when the grip is released",
      "Release"
    )
  end

  -- Right hand: travel between bodies. Left hand: time
  openspace.navigation.bindJoystickButton(
    Name,
    controller.A,
    "openspace.action.triggerAction('" .. FlyToNextBody.Identifier .. "')",
    "Fly to the next body"
  )
  openspace.navigation.bindJoystickButton(
    Name,
    controller.B,
    "openspace.action.triggerAction('" .. FlyToPreviousBody.Identifier .. "')",
    "Fly to the previous body"
  )
  openspace.navigation.bindJoystickButton(
    Name,
    controller.X,
    "openspace.time.interpolatePreviousDeltaTimeStep()",
    "Go backwards in time, faster the more times this button is pressed"
  )
  openspace.navigation.bindJoystickButton(
    Name,
    controller.Y,
    "openspace.time.interpolateNextDeltaTimeStep()",
    "Go forwards in time, faster the more times this button is pressed"
  )
  openspace.navigation.bindJoystickButton(
    Name,
    controller.LeftStickButton,
    "openspace.time.interpolateTogglePause()",
    "Pause or resume the time simulation"
  )
  openspace.navigation.bindJoystickButton(
    Name,
    controller.Menu,
    "openspace.time.interpolateDeltaTime(1)",
    "Reset to realtime"
  )
end


asset.onInitialize(function()
  openspace.addScreenSpaceRenderable(Message)
  openspace.action.registerAction(LockedMode)
  openspace.action.registerAction(FreeFlightMode)
  openspace.action.registerAction(ToggleNavigationMode)
  openspace.action.registerAction(FlyToNextBody)
  openspace.action.registerAction(FlyToPreviousBody)
  bindInputs()
end)

asset.onDeinitialize(function()
  openspace.navigation.unbindJoystick(Name)
  openspace.action.removeAction(FlyToPreviousBody)
  openspace.action.removeAction(FlyToNextBody)
  openspace.action.removeAction(ToggleNavigationMode)
  openspace.action.removeAction(FreeFlightMode)
  openspace.action.removeAction(LockedMode)
  openspace.removeScreenSpaceRenderable(Message)
end)

asset.export("LockedMode", LockedMode.Identifier)
asset.export("FreeFlightMode", FreeFlightMode.Identifier)
asset.export("ToggleNavigationMode", ToggleNavigationMode.Identifier)
asset.export("FlyToNextBody", FlyToNextBody.Identifier)
asset.export("FlyToPreviousBody", FlyToPreviousBody.Identifier)



asset.meta = {
  Name = "Joystick controller: OpenXR controllers",
  Description = [[
    Navigation with the hand controllers of an OpenXR headset. Locked on a body: the
    left thumbstick orbits, the right thumbstick zooms and turns. Free flight: the left
    thumbstick turns and flies up and down, the right thumbstick flies forward, back and
    sideways along the right controller's ray. Clicking the right thumbstick switches
    between the two, and locking focuses on the closest body. A and B fly to the next
    and previous body. Holding a grip slows down movement. X and Y step time backwards
    and forwards, the left thumbstick click pauses time and the menu button returns to
    realtime
  ]],
  Author = "OpenSpace in VR",
  URL = "https://github.com/jphpme/OpenSpace",
  License = "MIT license"
}
