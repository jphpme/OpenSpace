From 92277740b24b814cab895be07c5bb9835f537dda Mon Sep 17 00:00:00 2001
From: jphpme <jphpme@proton.me>
Date: Thu, 5 Nov 2026 07:57:05 +0100
Subject: [PATCH 2/2] Add OpenXR controller input through an action set

Create an action set with aim pose, thumbstick, trigger, grip and button actions for
both hands, suggest bindings for the Oculus Touch, Valve Index, HTC Vive and Khronos
simple controller profiles, and sync them every frame in updatePoses. The state is
available through openxr::controllerState(Hand). Interaction profile changes and the
controller state are logged with the frame statistics.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/sgct/openxr.h |  27 ++++
 src/openxr.cpp        | 367 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 394 insertions(+)

diff --git a/include/sgct/openxr.h b/include/sgct/openxr.h
index 2ed6ab0b..9e0cb74e 100644
--- a/include/sgct/openxr.h
+++ b/include/sgct/openxr.h
@@ -18,6 +18,29 @@
 namespace sgct { class Window; }
 
 namespace sgct::openxr {
+    enum class Hand { Left = 0, Right = 1 };
+
+    /// The state of one hand controller, as of the most recent call to `updatePoses`
+    struct ControllerState {
+        /// `true` if the runtime currently tracks the aim pose of this controller
+        bool isActive = false;
+        /// The aim pose (the ray pointing forward from the controller) in the same
+        /// tracking space as the eye poses
+        glm::mat4 aimPose = glm::mat4(1.f);
+        /// Thumbstick (or trackpad) position, each component in [-1, 1], up is +y
+        glm::vec2 thumbstick = glm::vec2(0.f);
+        /// Trigger value in [0, 1]
+        float trigger = 0.f;
+        /// Grip (squeeze) value in [0, 1]
+        float grip = 0.f;
+        /// A on the right hand, X on the left hand
+        bool primaryButton = false;
+        /// B on the right hand, Y on the left hand
+        bool secondaryButton = false;
+        bool thumbstickClick = false;
+        bool menuButton = false;
+    };
+
     /// Initialize OpenXR using the current OpenGL context.
     SGCT_EXPORT void initialize(float nearClip, float farClip);
 
@@ -44,6 +67,10 @@ namespace sgct::openxr {
 
     SGCT_EXPORT glm::mat4 poseMatrix();
     SGCT_EXPORT glm::quat inverseRotation(glm::mat4 poseMat);
+
+    /// Returns the controller state for \p hand. All values are zero or `false` if
+    /// OpenXR is not active, the session is not focused, or the controller is off.
+    SGCT_EXPORT const ControllerState& controllerState(Hand hand);
 } // namespace sgct::openxr
 
 #endif // SGCT_HAS_OPENXR
diff --git a/src/openxr.cpp b/src/openxr.cpp
index 7d7c2cbc..ae28c518 100644
--- a/src/openxr.cpp
+++ b/src/openxr.cpp
@@ -44,7 +44,9 @@
 #include <cstring>
 #include <format>
 #include <limits>
+#include <initializer_list>
 #include <optional>
+#include <string>
 #include <string_view>
 #include <vector>
 
@@ -981,6 +983,345 @@ namespace {
         return succeeded(res, "Create local space");
     }
 
+    struct ControllerActions {
+        XrActionSet actionSet = XR_NULL_HANDLE;
+        XrAction aimPose = XR_NULL_HANDLE;
+        XrAction thumbstick = XR_NULL_HANDLE;
+        XrAction trigger = XR_NULL_HANDLE;
+        XrAction grip = XR_NULL_HANDLE;
+        XrAction primaryButton = XR_NULL_HANDLE;
+        XrAction secondaryButton = XR_NULL_HANDLE;
+        XrAction thumbstickClick = XR_NULL_HANDLE;
+        XrAction menuButton = XR_NULL_HANDLE;
+        std::array<XrPath, 2> handPaths = { XR_NULL_PATH, XR_NULL_PATH };
+        std::array<XrSpace, 2> aimSpaces = { XR_NULL_HANDLE, XR_NULL_HANDLE };
+    };
+    ControllerActions controllerActions;
+    std::array<openxr::ControllerState, 2> controllerStates;
+
+    XrPath stringToPath(const std::string& path) {
+        XrPath result = XR_NULL_PATH;
+        succeeded(xrStringToPath(instance, path.c_str(), &result), path);
+        return result;
+    }
+
+    XrAction createAction(const char* name, const char* localizedName,
+                          XrActionType type)
+    {
+        XrActionCreateInfo info = {
+            .type = XR_TYPE_ACTION_CREATE_INFO,
+            .actionType = type,
+            .countSubactionPaths = static_cast<uint32_t>(
+                controllerActions.handPaths.size()
+            ),
+            .subactionPaths = controllerActions.handPaths.data()
+        };
+        std::strncpy(info.actionName, name, XR_MAX_ACTION_NAME_SIZE - 1);
+        std::strncpy(
+            info.localizedActionName,
+            localizedName,
+            XR_MAX_LOCALIZED_ACTION_NAME_SIZE - 1
+        );
+        XrAction action = XR_NULL_HANDLE;
+        const XrResult res = xrCreateAction(controllerActions.actionSet, &info, &action);
+        succeeded(res, std::format("Create action '{}'", name));
+        return action;
+    }
+
+    struct Binding {
+        XrAction action;
+        std::string path;
+    };
+
+    void suggestBindings(const std::string& profile, const std::vector<Binding>& bindings)
+    {
+        std::vector<XrActionSuggestedBinding> suggested;
+        suggested.reserve(bindings.size());
+        for (const Binding& binding : bindings) {
+            suggested.push_back({
+                .action = binding.action,
+                .binding = stringToPath(binding.path)
+            });
+        }
+
+        const XrInteractionProfileSuggestedBinding info = {
+            .type = XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING,
+            .interactionProfile = stringToPath(profile),
+            .countSuggestedBindings = static_cast<uint32_t>(suggested.size()),
+            .suggestedBindings = suggested.data()
+        };
+        const XrResult res = xrSuggestInteractionProfileBindings(instance, &info);
+        succeeded(res, std::format("Suggest bindings for '{}'", profile));
+    }
+
+    void createControllerActions() {
+        ControllerActions& a = controllerActions;
+
+        XrActionSetCreateInfo setInfo = {
+            .type = XR_TYPE_ACTION_SET_CREATE_INFO,
+            .priority = 0
+        };
+        std::strncpy(setInfo.actionSetName, "sgct", XR_MAX_ACTION_SET_NAME_SIZE - 1);
+        std::strncpy(
+            setInfo.localizedActionSetName,
+            "SGCT",
+            XR_MAX_LOCALIZED_ACTION_SET_NAME_SIZE - 1
+        );
+        XrResult res = xrCreateActionSet(instance, &setInfo, &a.actionSet);
+        if (!succeeded(res, "Create action set")) {
+            return;
+        }
+
+        a.handPaths = {
+            stringToPath("/user/hand/left"),
+            stringToPath("/user/hand/right")
+        };
+        a.aimPose = createAction("aim_pose", "Aim pose", XR_ACTION_TYPE_POSE_INPUT);
+        a.thumbstick = createAction(
+            "thumbstick",
+            "Thumbstick",
+            XR_ACTION_TYPE_VECTOR2F_INPUT
+        );
+        a.trigger = createAction("trigger", "Trigger", XR_ACTION_TYPE_FLOAT_INPUT);
+        a.grip = createAction("grip", "Grip", XR_ACTION_TYPE_FLOAT_INPUT);
+        a.primaryButton = createAction(
+            "primary_button",
+            "Primary button (A/X)",
+            XR_ACTION_TYPE_BOOLEAN_INPUT
+        );
+        a.secondaryButton = createAction(
+            "secondary_button",
+            "Secondary button (B/Y)",
+            XR_ACTION_TYPE_BOOLEAN_INPUT
+        );
+        a.thumbstickClick = createAction(
+            "thumbstick_click",
+            "Thumbstick click",
+            XR_ACTION_TYPE_BOOLEAN_INPUT
+        );
+        a.menuButton = createAction("menu_button", "Menu", XR_ACTION_TYPE_BOOLEAN_INPUT);
+
+        // Binds `action` to `suffix` on both hands
+        const auto both = [](XrAction action, std::string_view suffix) {
+            return std::vector<Binding>{
+                { action, std::format("/user/hand/left/{}", suffix) },
+                { action, std::format("/user/hand/right/{}", suffix) }
+            };
+        };
+        const auto join = [](std::initializer_list<std::vector<Binding>> lists) {
+            std::vector<Binding> result;
+            for (const std::vector<Binding>& list : lists) {
+                result.insert(result.end(), list.begin(), list.end());
+            }
+            return result;
+        };
+
+        // Each profile only lists paths that exist for it, as one unsupported path
+        // makes the runtime reject the whole suggestion for that profile
+        suggestBindings(
+            "/interaction_profiles/oculus/touch_controller",
+            join({
+                both(a.aimPose, "input/aim/pose"),
+                both(a.thumbstick, "input/thumbstick"),
+                both(a.trigger, "input/trigger/value"),
+                both(a.grip, "input/squeeze/value"),
+                both(a.thumbstickClick, "input/thumbstick/click"),
+                {
+                    { a.primaryButton, "/user/hand/left/input/x/click" },
+                    { a.primaryButton, "/user/hand/right/input/a/click" },
+                    { a.secondaryButton, "/user/hand/left/input/y/click" },
+                    { a.secondaryButton, "/user/hand/right/input/b/click" },
+                    { a.menuButton, "/user/hand/left/input/menu/click" }
+                }
+            })
+        );
+        suggestBindings(
+            "/interaction_profiles/valve/index_controller",
+            join({
+                both(a.aimPose, "input/aim/pose"),
+                both(a.thumbstick, "input/thumbstick"),
+                both(a.trigger, "input/trigger/value"),
+                both(a.grip, "input/squeeze/value"),
+                both(a.thumbstickClick, "input/thumbstick/click"),
+                both(a.primaryButton, "input/a/click"),
+                both(a.secondaryButton, "input/b/click")
+            })
+        );
+        suggestBindings(
+            "/interaction_profiles/htc/vive_controller",
+            join({
+                both(a.aimPose, "input/aim/pose"),
+                both(a.thumbstick, "input/trackpad"),
+                both(a.trigger, "input/trigger/value"),
+                both(a.grip, "input/squeeze/click"),
+                both(a.thumbstickClick, "input/trackpad/click"),
+                both(a.menuButton, "input/menu/click")
+            })
+        );
+        suggestBindings(
+            "/interaction_profiles/khr/simple_controller",
+            join({
+                both(a.aimPose, "input/aim/pose"),
+                both(a.trigger, "input/select/click"),
+                both(a.menuButton, "input/menu/click")
+            })
+        );
+
+        for (size_t i = 0; i < a.aimSpaces.size(); i++) {
+            const XrActionSpaceCreateInfo spaceInfo = {
+                .type = XR_TYPE_ACTION_SPACE_CREATE_INFO,
+                .action = a.aimPose,
+                .subactionPath = a.handPaths[i],
+                .poseInActionSpace = { .orientation = { .w = 1.f } }
+            };
+            res = xrCreateActionSpace(session, &spaceInfo, &a.aimSpaces[i]);
+            succeeded(res, "Create controller aim space");
+        }
+
+        const XrSessionActionSetsAttachInfo attachInfo = {
+            .type = XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO,
+            .countActionSets = 1,
+            .actionSets = &a.actionSet
+        };
+        res = xrAttachSessionActionSets(session, &attachInfo);
+        if (succeeded(res, "Attach action sets")) {
+            Log::Info("OpenXR controller actions created");
+        }
+    }
+
+    void destroyControllerActions() {
+        for (XrSpace& space : controllerActions.aimSpaces) {
+            if (space != XR_NULL_HANDLE) {
+                xrDestroySpace(space);
+            }
+        }
+        if (controllerActions.actionSet != XR_NULL_HANDLE) {
+            // Destroying the action set also destroys its actions
+            xrDestroyActionSet(controllerActions.actionSet);
+        }
+        controllerActions = ControllerActions();
+        controllerStates = {};
+    }
+
+    XrActionStateGetInfo stateInfo(XrAction action, XrPath hand) {
+        return {
+            .type = XR_TYPE_ACTION_STATE_GET_INFO,
+            .action = action,
+            .subactionPath = hand
+        };
+    }
+
+    float floatState(XrAction action, XrPath hand) {
+        const XrActionStateGetInfo info = stateInfo(action, hand);
+        XrActionStateFloat state = { .type = XR_TYPE_ACTION_STATE_FLOAT };
+        const XrResult res = xrGetActionStateFloat(session, &info, &state);
+        return XR_SUCCEEDED(res) && state.isActive ? state.currentState : 0.f;
+    }
+
+    bool booleanState(XrAction action, XrPath hand) {
+        const XrActionStateGetInfo info = stateInfo(action, hand);
+        XrActionStateBoolean state = { .type = XR_TYPE_ACTION_STATE_BOOLEAN };
+        const XrResult res = xrGetActionStateBoolean(session, &info, &state);
+        return XR_SUCCEEDED(res) && state.isActive && state.currentState;
+    }
+
+    glm::vec2 vector2State(XrAction action, XrPath hand) {
+        const XrActionStateGetInfo info = stateInfo(action, hand);
+        XrActionStateVector2f state = { .type = XR_TYPE_ACTION_STATE_VECTOR2F };
+        const XrResult res = xrGetActionStateVector2f(session, &info, &state);
+        if (XR_FAILED(res) || !state.isActive) {
+            return glm::vec2(0.f);
+        }
+        return glm::vec2(state.currentState.x, state.currentState.y);
+    }
+
+    void updateControllers() {
+        const ControllerActions& a = controllerActions;
+        if (a.actionSet == XR_NULL_HANDLE) {
+            return;
+        }
+
+        const XrActiveActionSet activeSet = {
+            .actionSet = a.actionSet,
+            .subactionPath = XR_NULL_PATH
+        };
+        const XrActionsSyncInfo syncInfo = {
+            .type = XR_TYPE_ACTIONS_SYNC_INFO,
+            .countActiveActionSets = 1,
+            .activeActionSets = &activeSet
+        };
+        const XrResult res = xrSyncActions(session, &syncInfo);
+        if (res != XR_SUCCESS) {
+            // XR_SESSION_NOT_FOCUSED is a success code, but no input is delivered then
+            if (XR_FAILED(res)) {
+                succeeded(res, "Sync actions");
+            }
+            controllerStates = {};
+            return;
+        }
+
+        for (size_t i = 0; i < controllerStates.size(); i++) {
+            openxr::ControllerState& s = controllerStates[i];
+            const XrPath hand = a.handPaths[i];
+            s.thumbstick = vector2State(a.thumbstick, hand);
+            s.trigger = floatState(a.trigger, hand);
+            s.grip = floatState(a.grip, hand);
+            s.primaryButton = booleanState(a.primaryButton, hand);
+            s.secondaryButton = booleanState(a.secondaryButton, hand);
+            s.thumbstickClick = booleanState(a.thumbstickClick, hand);
+            s.menuButton = booleanState(a.menuButton, hand);
+
+            XrSpaceLocation location = { .type = XR_TYPE_SPACE_LOCATION };
+            const XrResult r = xrLocateSpace(
+                a.aimSpaces[i],
+                appSpace,
+                predictedDisplayTime,
+                &location
+            );
+            constexpr XrSpaceLocationFlags Valid =
+                XR_SPACE_LOCATION_POSITION_VALID_BIT |
+                XR_SPACE_LOCATION_ORIENTATION_VALID_BIT;
+            s.isActive = XR_SUCCEEDED(r) && (location.locationFlags & Valid) == Valid;
+            if (s.isActive) {
+                s.aimPose = transformMatrix(location.pose);
+            }
+        }
+    }
+
+    void logInteractionProfiles() {
+        for (size_t i = 0; i < controllerActions.handPaths.size(); i++) {
+            XrInteractionProfileState state = {
+                .type = XR_TYPE_INTERACTION_PROFILE_STATE
+            };
+            const XrResult res = xrGetCurrentInteractionProfile(
+                session,
+                controllerActions.handPaths[i],
+                &state
+            );
+            if (!succeeded(res, "Get current interaction profile")) {
+                continue;
+            }
+
+            std::string profile = "none";
+            if (state.interactionProfile != XR_NULL_PATH) {
+                std::array<char, XR_MAX_PATH_LENGTH> buffer = {};
+                uint32_t length = 0;
+                xrPathToString(
+                    instance,
+                    state.interactionProfile,
+                    static_cast<uint32_t>(buffer.size()),
+                    &length,
+                    buffer.data()
+                );
+                profile = buffer.data();
+            }
+            Log::Info(std::format(
+                "OpenXR {} hand interaction profile: {}",
+                i == 0 ? "left" : "right", profile
+            ));
+        }
+    }
+
